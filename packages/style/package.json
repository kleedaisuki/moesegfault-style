{
  "name": "@moesegfault/style",
  "version": "0.1.2",
  "description": "Warm editorial design system for Astro, React and the web.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "astro",
    "README.md",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./astro": "./astro/index.ts",
    "./code": {
      "types": "./dist/code.d.ts",
      "import": "./dist/code.js",
      "default": "./dist/code.js"
    },
    "./icons/*": "./dist/assets/icons/*",
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "import": "./dist/markdown.js",
      "default": "./dist/markdown.js"
    },
    "./react/rich-text": {
      "types": "./dist/react/rich-text.d.ts",
      "import": "./dist/react/rich-text.js",
      "default": "./dist/react/rich-text.js"
    },
    "./astro/Markdown.astro": "./astro/Markdown.astro",
    "./astro/Math.astro": "./astro/Math.astro",
    "./markdown.css": "./dist/css/markdown.css",
    "./math.css": "./dist/css/math.css",
    "./astro/CodeBlock.astro": "./astro/CodeBlock.astro",
    "./astro/BrandMark.astro": "./astro/BrandMark.astro",
    "./astro/Button.astro": "./astro/Button.astro",
    "./astro/Card.astro": "./astro/Card.astro",
    "./astro/Cluster.astro": "./astro/Cluster.astro",
    "./astro/Container.astro": "./astro/Container.astro",
    "./astro/Stack.astro": "./astro/Stack.astro",
    "./tokens.css": "./dist/css/tokens.css",
    "./foundation.css": "./dist/css/foundation.css",
    "./components.css": "./dist/css/components.css",
    "./glass.css": "./dist/css/glass.css",
    "./motion.css": "./dist/css/motion.css",
    "./messages.css": "./dist/css/messages.css",
    "./code.css": "./dist/css/code.css",
    "./icons.css": "./dist/css/icons.css",
    "./all.css": "./dist/css/all.css",
    "./tokens.json": "./dist/tokens/tokens.json",
    "./tokens.dtcg.json": "./dist/tokens/tokens.dtcg.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/build-tokens.mjs --clean-only",
    "build": "node scripts/build-tokens.mjs --clean && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run && pnpm test:types",
    "test:types": "pnpm build && tsc -p tests/types/nodenext/tsconfig.json",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^28.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "katex": "^0.18.6",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  }
}
