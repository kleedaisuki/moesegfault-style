---
import type { HTMLAttributes } from "astro/types";

/** 徽章色调。Badge tones. */
export type BadgeTone = "neutral" | "accent" | "success" | "warning" | "danger";

interface Props extends HTMLAttributes<"span"> {
  /** 徽章色调。Badge tone. */
  tone?: BadgeTone;
}
const { tone = "neutral", class: className, ...rest } = Astro.props;
---
<span {...rest} class:list={["moe-badge", className]} data-tone={tone}><slot /></span>
