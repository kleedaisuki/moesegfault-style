---
import Container from "@moesegfault/style/astro/Container.astro";
import { ComponentGallery } from "../../components/ComponentGallery";
import CodeBlock from "../../components/CodeBlock.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
---

<DocsLayout
  title="组件 Showcase"
  description="MoeSegFault Style 的 React 组件与组合模式展示。"
  currentPath="/components/"
>
  <header class="page-intro">
    <Container>
      <p class="kicker">COMPONENTS</p>
      <h1>小而完整的工具箱。</h1>
      <p class="lede">基础组件保持诚实：原生语义、可组合的 Props、没有为了 Demo 发明的隐藏状态。</p>
    </Container>
  </header>
  <section class="section section-tint" aria-label="组件展示">
    <Container>
      <ComponentGallery client:load />
      <CodeBlock
        label="React · composition.tsx"
        code={`import { Badge, Button, Card, StatusDot } from "@moesegfault/style/react";\nimport "@moesegfault/style/all.css";\n\nexport function ProjectCard() {\n  return (\n    <Card>\n      <Badge tone="success">Stable</Badge>\n      <h2><StatusDot label="Online" status="online" /> Style service</h2>\n      <Button variant="secondary">Open</Button>\n    </Card>\n  );\n}`}
      />
    </Container>
  </section>
</DocsLayout>
