---
import Button from "@moesegfault/style/astro/Button.astro";
import Card from "@moesegfault/style/astro/Card.astro";
import Cluster from "@moesegfault/style/astro/Cluster.astro";
import Container from "@moesegfault/style/astro/Container.astro";
import Stack from "@moesegfault/style/astro/Stack.astro";
import DocsLayout from "../../layouts/DocsLayout.astro";
---

<DocsLayout title="A warm interface workshop" description="A warm editorial design system for TypeScript, React, and Astro." currentPath="/en/" locale="en">
  <section class="hero">
    <Container>
      <div class="hero-grid">
        <div>
          <p class="kicker">DESIGN SYSTEM · v0.1.2</p>
          <h1>A warm sheet of paper for your code.</h1>
          <p class="lede">Warm paper, berry-red ink. A shared workshop for long reads, useful tools, and ideas exchanged in conversation. Let the components mind the details while you keep writing.</p>
          <Cluster>
            <Button href="/en/components/">Browse components</Button>
            <Button href="/en/guides/" variant="secondary">Get started</Button>
          </Cluster>
        </div>
        <aside class="paper-note" aria-label="Design manifesto">
          <blockquote>“A proof on the page, a little light by the window. Serious work can have a playful side.”</blockquote>
          <p>Warm paper · Berry ink · A little sparkle</p>
        </aside>
      </div>
    </Container>
  </section>

  <section class="section section-tint" aria-labelledby="principles-title">
    <Container>
      <div class="section-heading"><div><p class="eyebrow">Principles</p><h2 id="principles-title">From a single button to a whole workbench</h2></div><p>Adopt progressively—from plain CSS to stateful React islands—without rewriting your application around the design system.</p></div>
      <div class="feature-grid">
        <Card><span class="feature-number">01</span><h3>Keep the familiar colors</h3><p>Colors, spacing, radii, and shadows have semantic names; themes change without changing component structure.</p><a href="/en/foundations/">Explore foundations →</a></Card>
        <Card><span class="feature-number">02</span><h3>Build around your project</h3><p>Use the same foundational CSS with static Astro components or interactive React components.</p><a href="/en/guides/">See integration guides →</a></Card>
        <Card><span class="feature-number">03</span><h3>Choose a comfortable way in</h3><p>The npm package fits build-time dependencies; versioned remote assets serve static pages without a bundler.</p><a href="/en/distribution/">Explore distribution →</a></Card>
      </div>
    </Container>
  </section>

  <section class="section" aria-labelledby="composition-title"><Container><div class="section-heading"><div><p class="eyebrow">Made with these pieces</p><h2 id="composition-title">No separate set built for the showcase</h2></div></div><Stack><p class="lede">Its containers, cards, buttons, clusters, and rhythm all come from <code>@moesegfault/style</code>. The foundational components you see here are the same ones you can bring into your project.</p><Cluster><Button href="/en/components/">Step into the component workshop</Button><Button href="/en/distribution/" variant="ghost">Choose a distribution channel</Button></Cluster></Stack></Container></section>
</DocsLayout>
