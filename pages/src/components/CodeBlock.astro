---
import CodeBlock from "@moesegfault/style/astro/CodeBlock.astro";

/** 保留文档组件原接口，并开放显式语言。Preserve the documentation API and accept explicit grammars. */
interface Props {
  /** 原始代码。Raw code. */
  code: string;
  /** 文件名，同时说明语言。Filename, which also names the language. */
  label: string;
  /** 高亮语法。Highlight grammar. */
  language?: string;
  /** 是否提供复制按钮。Whether to provide a copy button. */
  copyable?: boolean;
}

const { code, label, language = "astro", copyable = true } = Astro.props;
const english = Astro.url.pathname.startsWith("/en/");
---

<CodeBlock code={code} copyable={copyable} filename={label} language={language} copyLabel={english ? "Copy" : "复制"} copiedLabel={english ? "Copied" : "已复制"} copyErrorLabel={english ? "Copy failed; select code manually" : "复制失败，请选择代码复制"} />
