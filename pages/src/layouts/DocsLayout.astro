---
import "@moesegfault/style/all.css";
import BrandMark from "@moesegfault/style/astro/BrandMark.astro";
import Container from "@moesegfault/style/astro/Container.astro";
import { ThemeToggle } from "../components/ThemeToggle";
import { isCurrentPath, NAV_ITEMS } from "../lib/site";
import "../styles/docs.css";

interface Props {
  title: string;
  description: string;
  currentPath: string;
}

const { title, description, currentPath } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efe3" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22><text y=%22.9em%22 font-size=%2290%22>✦</text></svg>" />
    <title>{title} · MoeSegFault Style</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("moe-theme");
        const dark = saved === "dark" || (!saved && matchMedia("(prefers-color-scheme: dark)").matches);
        const theme = dark ? "dark" : "light";
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <Container>
        <div class="header-inner">
          <a class="brand-link" href="/" aria-label="MoeSegFault Style 首页">
            <BrandMark />
            <span class="brand-copy"><strong>MoeSegFault</strong><small>Style workshop</small></span>
          </a>
          <nav aria-label="主要导航">
            <ul>
              {NAV_ITEMS.map(({ href, label }) => (
                <li><a href={href} aria-current={isCurrentPath(currentPath, href) ? "page" : undefined}>{label}</a></li>
              ))}
            </ul>
          </nav>
          <ThemeToggle client:load />
        </div>
      </Container>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <Container>
        <div class="footer-inner">
          <p><strong>MoeSegFault Style</strong> — 给代码一张温暖的纸。</p>
          <p><a href="https://github.com/kleedaisuki/moesegfault-style">Source</a> · GPL-3.0-or-later</p>
        </div>
      </Container>
    </footer>
  </body>
</html>
